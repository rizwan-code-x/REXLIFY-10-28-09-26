rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: default deny for all unspecified paths
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Allow read and write operations on the 13 required synchronization collections
    match /shops/{document} {
      allow read, write: if true;
    }
    
    match /customers/{document} {
      allow read, write: if true;
    }
    
    match /appointments/{document} {
      allow read, write: if true;
    }
    
    match /tasks/{document} {
      allow read, write: if true;
    }
    
    match /services/{document} {
      allow read, write: if true;
    }
    
    match /inventories/{document} {
      allow read, write: if true;
    }
    
    match /staff/{document} {
      allow read, write: if true;
    }
    
    match /invoices/{document} {
      allow read, write: if true;
    }
    
    match /finance/{document} {
      allow read, write: if true;
    }
    
    match /vault/{document} {
      allow read, write: if true;
    }
    
    match /notifications/{document} {
      allow read, write: if true;
    }
    
    match /securityLogs/{document} {
      allow read, write: if true;
    }
    
    match /aiKnowledge/{document} {
      allow read, write: if true;
    }

    match /notices/{document} {
      allow read, write: if true;
    }

    match /inquiries/{document} {
      allow read, write: if true;
    }
  }
}
