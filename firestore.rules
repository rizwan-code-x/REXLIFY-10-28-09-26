rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Test connection doc
    match /test/connection {
      allow read, write: if true;
    }

    // Users Collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // Image Analyses Collection
    match /image_analyses/{analysisId} {
      allow read, write: if true;
    }

    // Contact Messages Collection
    match /messages/{messageId} {
      allow read, write: if true;
    }

    // Newsletter Subscribers Collection
    match /subscribers/{subscriberId} {
      allow read, write: if true;
    }

    // Config Collection
    match /config/{configId} {
      allow read, write: if true;
    }

    // Services Collection
    match /services/{serviceId} {
      allow read, write: if true;
    }

    // Notifications Collection
    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    // Tasks Collection
    match /tasks/{taskId} {
      allow read, write: if true;
    }

    // Appointments Collection
    match /appointments/{appointmentId} {
      allow read, write: if true;
    }

    // Security Logs Collection
    match /securityLogs/{logId} {
      allow read, write: if true;
    }

    // Session Logs Collection
    match /sessionLogs/{logId} {
      allow read, write: if true;
    }

    // AI Knowledge Collection
    match /aiKnowledge/{knowledgeId} {
      allow read, write: if true;
    }

    // Inventories Collection
    match /inventories/{inventoryId} {
      allow read, write: if true;
    }

    // Customers Collection
    match /customers/{customerId} {
      allow read, write: if true;
    }

    // Shops Collection
    match /shops/{shopId} {
      allow read, write: if true;
    }

    // Invoices Collection
    match /invoices/{invoiceId} {
      allow read, write: if true;
    }

    // Staff Collection
    match /staff/{staffId} {
      allow read, write: if true;
    }

    // Finance Collection
    match /finance/{financeId} {
      allow read, write: if true;
    }

    // Vault Collection
    match /vault/{vaultId} {
      allow read, write: if true;
    }

    // Notices Collection
    match /notices/{noticeId} {
      allow read, write: if true;
    }

    // Inquiries Collection
    match /inquiries/{inquiryId} {
      allow read, write: if true;
    }

    // Group Messages Collection
    match /groupMessages/{messageId} {
      allow read, write: if true;
    }

    // Group Settings Collection
    match /groupSettings/{settingId} {
      allow read, write: if true;
    }

    // Rexlify Voice Sessions Collection
    match /rexlify_voice_sessions/{sessionId} {
      allow read, write: if true;
    }

    // Branch Conversations & Messaging
    match /conversations/{conversationId} {
      allow read, write: if true;
    }

    match /conversation_messages/{messageId} {
      allow read, write: if true;
    }

    // Branch Service Settings & Overrides
    match /branch_service_settings/{settingId} {
      allow read, write: if true;
    }

    // Service Change Notifications for CEO
    match /service_notifications/{notificationId} {
      allow read, write: if true;
    }

    // Branch Customer Live Chats
    match /branch_chats/{chatId} {
      allow read, write: if true;
    }
  }
}

